# CineTale v1.9.10 — deployment configuration

# Story planning. Configure one or both.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional per-quality routing. If blank, all qualities use GEMINI_IMAGE_MODEL.
GEMINI_IMAGE_MODEL_DRAFT=
GEMINI_IMAGE_MODEL_STANDARD=
GEMINI_IMAGE_MODEL_PREMIUM=
OPENAI_IMAGE_MODEL=gpt-image-2
# When both Gemini and OpenAI keys are configured, CineTale uses OpenAI as a backup visual provider after retryable Gemini quota/service failures.

# Voice generation, story transcription, and reusable character voice assignments
# Story transcription prefers ElevenLabs Scribe when configured and can fall back to Gemini audio understanding.
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional dedicated narrator voice. Character voices can auto-assign from your ElevenLabs catalog.
ELEVENLABS_NARRATOR_VOICE_ID=
# Expressive default; falls back to multilingual_v2 if v3 is unavailable for the account/voice.
ELEVENLABS_TTS_MODEL=eleven_v3

# Live video generation through Google Veo
# Off by default so deployment cannot accidentally spend video credits.
ENABLE_LIVE_VIDEO=false
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=6
# Optional per-quality video routing. Recommended defaults:
# Draft: Veo 3.1 Lite / 4s / 720p
# Standard: Veo 3.1 Fast / 6s / 720p
# Premium: Veo 3.1 / 8s / 1080p If blank, all qualities use the defaults above.
VEO_MODEL_DRAFT=veo-3.1-lite-generate-preview
VEO_MODEL_STANDARD=veo-3.1-fast-generate-preview
VEO_MODEL_PREMIUM=veo-3.1-generate-preview
VEO_RESOLUTION_DRAFT=720p
VEO_RESOLUTION_STANDARD=720p
VEO_RESOLUTION_PREMIUM=1080p
VEO_DURATION_DRAFT=4
VEO_DURATION_STANDARD=6
VEO_DURATION_PREMIUM=8
# 16:9 for Episode/Story/Movie; Short automatically uses 9:16 unless overridden in code.
VEO_ASPECT_RATIO=16:9

# Optional generic video adapter. Used only if configured and Google Veo is not enabled.
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_KEY=


# Dedicated lip synchronization for approved CineTale voices.
# This is a render stage: the provider receives the source video + final approved voice audio
# and returns one finished MP4 with the synchronized mouth movement and audio embedded.
ENABLE_LIVE_LIPSYNC=false
# auto prefers Sync Labs when SYNC_API_KEY is configured, then falls back to FAL if available.
LIPSYNC_PROVIDER=auto

# Recommended production lip-sync route
SYNC_API_KEY=
SYNC_LIPSYNC_MODEL=sync-3

# Optional fallback route
FAL_KEY=
LIPSYNC_MODEL=fal-ai/sync-lipsync/v3
LIPSYNC_SYNC_MODE=remap

# Owner console
OWNER_CODE=
# Optional comma-separated creator emails that should automatically receive owner diagnostics after sign-in.
OWNER_EMAILS=

# Optional creator accounts (email/password + Google OAuth through Supabase)
SUPABASE_URL=
# Optional branded Supabase custom-domain origin used ONLY to start Google OAuth,
# e.g. https://auth.your-cinetale-domain.com . Configure the same custom domain in
# Supabase first; otherwise leave blank and CineTale uses SUPABASE_URL.
SUPABASE_OAUTH_URL=
# Public browser-safe Supabase publishable/anon key (never use service_role here)
SUPABASE_ANON_KEY=
# Optional alias for newer Supabase naming; either this or SUPABASE_ANON_KEY can be used.
SUPABASE_PUBLISHABLE_KEY=
# Optional: future login gate; current UI remains guest-friendly
REQUIRE_AUTH=false

# Optional. With both keys configured CineTale defaults to OpenAI first for reliable live-verified image generation.
# Set to gemini only if you intentionally want Gemini first.
VISUAL_PRIMARY_PROVIDER=
